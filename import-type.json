{
  "id": "",
  "name": "Open-Meteo forecast archive (previous runs)",
  "description": "Archived Open-Meteo weather forecasts as they were issued, from the Previous Runs API: one message per forecast hour and lead day, published at its issue time (time = issued_at = forecasted_for minus lead_days). Backfills from start, then continues hourly. Data: Open-Meteo, CC BY 4.0.",
  "image": "ghcr.io/senergy-platform/import-open-meteo-previous-runs:prod",
  "default_restart": true,
  "configs": [
    {
      "name": "lat",
      "description": "Coordinate latitude",
      "type": "https://schema.org/Float",
      "default_value": 51.34
    },
    {
      "name": "long",
      "description": "Coordinate longitude",
      "type": "https://schema.org/Float",
      "default_value": 12.38
    },
    {
      "name": "start",
      "description": "First issue date to backfill, YYYY-MM-DD. Most models are available from 2024-01-01.",
      "type": "https://schema.org/Text",
      "default_value": "2024-01-01"
    },
    {
      "name": "lead_days",
      "description": "Lead times in days, each 1 to 7. lead_days 2 is safe for a day-ahead forecast; 1 can be slightly optimistic because the model run may have been published after the nominal issue time.",
      "type": "https://schema.org/ItemList",
      "default_value": [
        1,
        2
      ]
    },
    {
      "name": "model",
      "description": "One Open-Meteo model, e.g. icon_seamless or ecmwf_ifs025. best_match lets Open-Meteo choose per location.",
      "type": "https://schema.org/Text",
      "default_value": "best_match"
    },
    {
      "name": "apikey",
      "description": "Optional commercial Open-Meteo API key; empty uses the free, non-commercial API.",
      "type": "https://schema.org/Text",
      "default_value": ""
    }
  ],
